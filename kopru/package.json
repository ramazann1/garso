{
  "name": "garso-kopru",
  "version": "1.2.4",
  "private": true,
  "type": "module",
  "description": "Garso Kasa Köprüsü — kasada çalışır, yazdırma kuyruğundaki fişleri yazıcıya basar.",
  "main": "elektron/ana.js",
  "scripts": {
    "start": "electron .",
    "terminal": "node src/index.js",
    "yazicilar": "node src/index.js yazicilar",
    "paketle": "node paketle.js"
  },
  "build": {
    "appId": "app.garso.kopru",
    "productName": "Garso Kasa Köprüsü",
    "directories": {
      "output": "${env.LOCALAPPDATA}/Garso/dagitim"
    },
    "files": [
      "elektron/**",
      "arayuz/**",
      "src/**",
      "varliklar/**"
    ],
    "asarUnpack": [
      "varliklar/**",
      "node_modules/@napi-rs/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "varliklar/simge-256.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "artifactName": "garso-kopru-kurulum-${version}.${ext}",
      "shortcutName": "Garso Kasa Köprüsü",
      "uninstallDisplayName": "Garso Kasa Köprüsü ${version}",
      "license": "kurulum/lisans.txt",
      "installerSidebar": "kurulum/kenar.bmp",
      "uninstallerSidebar": "kurulum/kenar.bmp",
      "installerHeader": "kurulum/serit.bmp",
      "include": "kurulum/kaldirma.nsh",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.6",
    "@supabase/supabase-js": "^2.111.0",
    "qrcode": "^1.5.4"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
